{
  "name": "key-flash",
  "version": "1.1.6",
  "description": "Key Flash is a Customer Relationship Management (CRM) software. Key Flash is a one-of-a-kind utility to manage invoices, inventory, and to create budgets. Its features are very unique and are easy-to-use to manage your personal and/or business profits without the time-consuming tasks to manually input data onto documents. With Key Flash, it is easy to enter data and generate a PDF and automatically save it to specific accounts to manage your data professionally to help make business management easier.",
  "main": "electron/main.js",
  "scripts": {
    "prestart": "cross-env NODE_DISABLE_COMPILE_CACHE=1 node ./scripts/repair-if-present.cjs",
    "start": "node ./scripts/run-shared-if-present.cjs ../_shared/vite-electron-dev.mjs --port 5189",
    "start:fixed": "concurrently \"npm run dev:renderer\" \"cross-env NODE_DISABLE_COMPILE_CACHE=1 VITE_DEV_SERVER_URL=http://127.0.0.1:5189/ npm run dev:main\"",
    "start:prod": "cross-env NODE_DISABLE_COMPILE_CACHE=1 MCR_STARTUP_MODE=offline NODE_ENV=production node ./scripts/dev-main-wrapper.cjs --offline",
    "predev": "cross-env NODE_DISABLE_COMPILE_CACHE=1 node ./scripts/repair-if-present.cjs",
    "dev": "node ./scripts/run-shared-if-present.cjs ../_shared/vite-electron-dev.mjs --port 5189",
    "dev:renderer": "cross-env NODE_DISABLE_COMPILE_CACHE=1 vite dev --host 127.0.0.1 --port 5189",
    "dev:main": "node ./scripts/dev-main-wrapper.cjs",
    "prebuild": "cross-env NODE_DISABLE_COMPILE_CACHE=1 node ./scripts/repair-if-present.cjs",
    "build": "npm run dist",
    "build:web": "cross-env NODE_DISABLE_COMPILE_CACHE=1 vite build",
    "dist": "cross-env NODE_DISABLE_COMPILE_CACHE=1 node ./scripts/run-shared-if-present.cjs ../_shared/run-electron-dist.mjs mac:universal",
    "dist:mac:x64": "npm run generate-icons && npm run build:web && node ./scripts/electron-builder-filter.mjs --mac --x64 --config electron-builder-mac-x64.json",
    "dist:mac:arm64": "npm run generate-icons && npm run build:web && node ./scripts/electron-builder-filter.mjs --mac --arm64 --config electron-builder-mac-arm64.json",
    "dist:mac:universal": "npm run generate-icons && npm run build:web && node ./scripts/electron-builder-filter.mjs --mac --universal --config electron-builder-mac-universal.json",
    "build:mac:x64": "npm run dist:mac:x64",
    "build:mac:arm64": "npm run dist:mac:arm64",
    "build:mac:universal": "npm run dist:mac:universal",
    "dist:win": "npm run generate-icons && npm run build:web && node ./scripts/electron-builder-filter.mjs --win --config electron-builder.base.json",
    "dist:linux": "npm run build:web && node ./scripts/electron-builder-filter.mjs --linux --config electron-builder.base.json",
    "build:win": "npm run dist:win",
    "build:linux": "npm run dist:linux",
    "predist": "cross-env NODE_DISABLE_COMPILE_CACHE=1 node ./scripts/repair-if-present.cjs",
    "package": "npm run build:web && electron-forge package",
    "prepackage": "cross-env NODE_DISABLE_COMPILE_CACHE=1 node ./scripts/repair-if-present.cjs",
    "make": "npm run build:web && electron-forge make",
    "premake": "cross-env NODE_DISABLE_COMPILE_CACHE=1 node ./scripts/repair-if-present.cjs",
    "publish": "npm run build:web && electron-forge publish",
    "prepublish": "cross-env NODE_DISABLE_COMPILE_CACHE=1 node ./scripts/repair-if-present.cjs",
    "postinstall": "cross-env NODE_DISABLE_COMPILE_CACHE=1 node ./scripts/repair-if-present.cjs",
    "lint": "echo \"No linting configured\"",
    "generate-icons": "node ./scripts/generate-macos-icon.mjs",
    "all": "bash ../run-all.sh",
    "scripts": "bash ../run-all.sh",
    "start:cloud": "node ./scripts/run-shared-if-present.cjs ../_shared/vite-electron-dev.mjs --port 5189",
    "start:offline": "cross-env NODE_DISABLE_COMPILE_CACHE=1 MCR_STARTUP_MODE=offline NODE_ENV=production node ./scripts/dev-main-wrapper.cjs --offline",
    "dev:cloud": "node ./scripts/run-shared-if-present.cjs ../_shared/vite-electron-dev.mjs --port 5189",
    "dev:offline": "cross-env NODE_DISABLE_COMPILE_CACHE=1 MCR_STARTUP_MODE=offline NODE_ENV=development node ./scripts/dev-main-wrapper.cjs --offline"
  },
  "build": {
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.productivity",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/{@img/sharp-darwin-x64,@img/sharp-libvips-darwin-x64,@img/sharp-darwin-arm64,@img/sharp-libvips-darwin-arm64,@napi-rs/canvas-darwin-x64}/**",
      "artifactName": "key-flash-${version}.dmg"
    },
    "portable": {
      "artifactName": "key-flash-${version}.exe"
    },
    "appId": "com.muha.keyflash",
    "productName": "Key Flash",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "src/**",
      "index.html",
      "preload.js",
      "startup-mode.cjs",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "forceCodeSigning": false,
    "afterPack": "./scripts/electron-builder-after-pack.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.16",
    "wait-on": "^9.0.1"
  },
  "keywords": [],
  "author": {
    "name": "alnabid",
    "email": "alnabidrm@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "bootstrap-icons": "^1.11.3",
    "docx": "^9.5.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "pdf-lib": "^1.17.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
